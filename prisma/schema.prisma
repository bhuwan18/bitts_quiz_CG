generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String        @id @default(cuid())
  email            String        @unique
  emailVerified    DateTime?
  name             String?
  image            String?
  coins            Int           @default(0)
  totalCoinsEarned Int           @default(0)
  totalCorrect     Int           @default(0)
  totalAnswered    Int           @default(0)
  isAdmin          Boolean       @default(false)
  isLocked         Boolean       @default(false)
  isPro            Boolean       @default(false)
  proExpiresAt     DateTime?
  dailyCoinsEarned Int           @default(0)
  dailyCoinsReset  DateTime      @default(now())
  lastSeenAt           DateTime?
  isMax                Boolean       @default(false)
  maxExpiresAt         DateTime?
  schoolAccessOverride Boolean       @default(false)
  currentStreak        Int           @default(0)
  longestStreak        Int           @default(0)
  lastStreakDate       DateTime?
  streakFreezes        Int           @default(0)
  createdAt            DateTime      @default(now())
  accounts             Account[]
  sessions             Session[]
  quizAttempts         QuizAttempt[]
  ownedQuizlets        UserQuizlet[]
  quizzesCreated       Quiz[]            @relation("QuizAuthor")
  paymentRequests      PaymentRequest[]
  feedbacks            Feedback[]
  correctAnswers       CorrectAnswer[]
  explanationReads     ExplanationRead[]
  notifications        Notification[]
  pushSubscriptions    PushSubscription[]
  milestones           UserMilestone[]
  followers            UserFollow[]  @relation("UserFollowing")
  following            UserFollow[]  @relation("UserFollowers")
  feedActivities       FeedActivity[]
  feedLikes            FeedLike[]
  feedComments         FeedComment[]
  feedReactions        FeedReaction[]
  nudgesSent           Nudge[] @relation("NudgeSender")
  nudgesReceived       Nudge[] @relation("NudgeRecipient")
  tradeListings        TradeListing[] @relation("TradeListings")
  tradeBids            TradeBid[]     @relation("TradeBids")
  weeklyCoins          Int     @default(0)
  weeklyCoinsWeek      String  @default("")
  weeklyCorrect        Int     @default(0)
  weeklyAnswered       Int     @default(0)
  dailyCoinsSpent      Int     @default(0)
  dailySpentReset      DateTime @default(now())
  isBlacksmith         Boolean   @default(false)
  blacksmithExpiresAt  DateTime?
  cgUserId             String?   @unique
  quizletSubmissions   QuizletSubmission[]
  createdQuizlets      Quizlet[]
  friendStreaksAsA     FriendStreak[] @relation("FriendStreakA")
  friendStreaksAsB     FriendStreak[] @relation("FriendStreakB")
  packMaxOpens         PackMaxOpen[]

  @@index([totalCoinsEarned])
  @@index([coins])
  @@index([lastSeenAt])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Quiz {
  id          String        @id @default(cuid())
  title       String
  description String?
  category    String
  difficulty  Int
  isOfficial  Boolean       @default(false)
  isNew       Boolean       @default(false)
  authorId    String
  author      User          @relation("QuizAuthor", fields: [authorId], references: [id])
  questions   Question[]
  attempts    QuizAttempt[]
  createdAt   DateTime      @default(now())

  @@index([category])
  @@index([authorId])
  @@index([isOfficial])
  @@index([isNew])
}

model Question {
  id           String  @id @default(cuid())
  quizId       String
  quiz         Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text         String
  options      Json
  correctIndex Int
  points       Int     @default(1)
  order        Int     @default(0)
  explanation  String? @db.Text
  readMoreUrl  String?
  imageUrl     String?

  @@index([quizId])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id])
  score       Int
  total       Int
  coinsEarned Int
  completedAt DateTime @default(now())

  @@index([userId])
  @@index([quizId])
  @@index([completedAt])
  @@index([userId, completedAt])
}

model Quizlet {
  id              String        @id @default(cuid())
  name            String        @unique
  rarity          String
  pack            String
  icon            String
  colorFrom       String
  colorTo         String
  description     String
  isHidden        Boolean       @default(false)
  sellValue       Int           @default(10)
  createdByUserId String?
  createdBy       User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  owners          UserQuizlet[]
  tradeListings   TradeListing[]

  @@index([createdByUserId])
}

model UserQuizlet {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  quizletId    String
  quizlet      Quizlet       @relation(fields: [quizletId], references: [id])
  quantity     Int           @default(1)
  obtainedAt   DateTime      @default(now())
  tradeListing TradeListing?

  @@unique([userId, quizletId])
  @@index([userId])
}

model PaymentRequest {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // "coins" | "pro"
  coins     Int?     // only set when type="coins"
  amountInr Int      // amount in INR (coins amount or 500 for pro)
  utrNumber String   // user-submitted UTR/transaction reference
  status    String   @default("pending") // "pending" | "approved" | "rejected"
  adminNote String?  // optional note from admin on rejection
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   @default("General")
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model CorrectAnswer {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([questionId])
}

model ExplanationRead {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // "overtaken" | "top3_join" | "feedback_reply"
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model Pack {
  id           String  @id @default(cuid())
  name         String
  description  String
  cost         Int
  slug         String  @unique
  icon         String
  colorFrom    String
  colorTo      String
  isFestival   Boolean @default(false)
  festivalDate String?
  isActive     Boolean @default(true)
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model UserMilestone {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestoneType String   @default("coins") // "coins" | "quizzes" | "answers" | "categories" | "streak"
  threshold     Int
  earnedAt      DateTime @default(now())

  @@unique([userId, milestoneType, threshold])
  @@index([userId])
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User @relation("UserFollowers", fields: [followerId],  references: [id], onDelete: Cascade)
  following   User @relation("UserFollowing", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model FriendStreak {
  id                String   @id @default(cuid())
  userAId           String   // always the lexicographically smaller userId
  userBId           String   // always the lexicographically larger userId
  userA             User     @relation("FriendStreakA", fields: [userAId], references: [id], onDelete: Cascade)
  userB             User     @relation("FriendStreakB", fields: [userBId], references: [id], onDelete: Cascade)
  count             Int      @default(0)
  longestCount      Int      @default(0)
  lastStreakDate    String?  // "YYYY-MM-DD" IST — last day both completed a quiz
  userALastQuizDate String?  // "YYYY-MM-DD" IST — last day A completed a quiz
  userBLastQuizDate String?  // "YYYY-MM-DD" IST — last day B completed a quiz
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model FeedActivity {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String        // quiz_completed | milestone_earned | quizlet_earned | streak_milestone | user_returned | leaderboard_top3
  data      Json
  createdAt DateTime      @default(now())
  likes     FeedLike[]
  comments  FeedComment[]
  reactions FeedReaction[]

  @@index([userId, createdAt])
  @@index([createdAt])
}

model FeedLike {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   FeedActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([userId, activityId])
  @@index([activityId])
}

model FeedComment {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   FeedActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  text       String       @db.Text
  createdAt  DateTime     @default(now())

  @@index([activityId])
  @@index([userId])
}

model FeedReaction {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   FeedActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  emoji      String       // "🔥" | "🎉" | "👏" | "😱"
  createdAt  DateTime     @default(now())

  @@unique([userId, activityId, emoji])
  @@index([activityId])
}

model Nudge {
  id          String   @id @default(cuid())
  senderId    String
  recipientId String
  createdAt   DateTime @default(now())

  sender    User @relation("NudgeSender",    fields: [senderId],    references: [id], onDelete: Cascade)
  recipient User @relation("NudgeRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
}

model DinoRexRoom {
  id             String    @id @default(cuid())
  code           String    @unique
  hostId         String
  status         String    @default("waiting") // waiting | playing | ended
  players        Json      // DinoRexPlayer[]
  questions      Json      @default("[]") // QuestionData[]
  currentQ       Int       @default(0)
  currentAnswers Json      @default("{}") // { [userId]: number }
  roundStartedAt DateTime?
  winner         String?   // userId of winner
  createdAt      DateTime  @default(now())

  @@index([code])
  @@index([status])
  @@index([createdAt])
}

model TradeListing {
  id            String      @id @default(cuid())
  sellerId      String
  seller        User        @relation("TradeListings", fields: [sellerId], references: [id], onDelete: Cascade)
  userQuizletId String      @unique
  userQuizlet   UserQuizlet @relation(fields: [userQuizletId], references: [id], onDelete: Cascade)
  quizletId     String
  quizlet       Quizlet     @relation(fields: [quizletId], references: [id])
  startingPrice Int
  buyNowPrice   Int?
  status        String      @default("active") // active | sold | expired | cancelled
  expiresAt     DateTime
  createdAt     DateTime    @default(now())
  bids          TradeBid[]

  @@index([sellerId])
  @@index([status, expiresAt])
  @@index([quizletId])
}

model TradeBid {
  id        String       @id @default(cuid())
  listingId String
  listing   TradeListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId  String
  bidder    User         @relation("TradeBids", fields: [bidderId], references: [id], onDelete: Cascade)
  amount    Int
  isHeld    Boolean      @default(true)
  createdAt DateTime     @default(now())

  @@index([listingId, amount])
  @@index([bidderId])
}

model QuizletSubmission {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  icon        String
  colorFrom   String
  colorTo     String
  rarity      String
  description String
  pack        String
  status      String   @default("pending") // pending | approved | rejected
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PackMaxOpen {
  id       String   @id @default(cuid())
  userId   String
  packSlug String
  usedAt   DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, packSlug])
  @@index([userId])
}
